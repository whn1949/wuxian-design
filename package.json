{
  "name": "dsh-wuxian-design",
  "version": "0.1.4",
  "description": "无限灵感设计：基于歸藏设计的开源改编版，保留 PPT、图文卡片、网页排版、去 AI 味与语气档案，增加统一入口和按需设计复核。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.png",
  "files": [
    "lib",
    "scripts",
    "skills",
    "gallery",
    "examples",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.png",
    "own-skills",
    "SKILL.md",
    "references",
    "agents",
    "说明.md",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "skills",
    "ppt",
    "design-system",
    "typography"
  ],
  "author": "whn1949",
  "contributors": ["op7418（上游原作者）"],
  "homepage": "https://github.com/whn1949/wuxian-design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whn1949/wuxian-design.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "playwright": "^1.60.0",
    "puppeteer-core": "^24.0.0",
    "subset-font": "^2.9.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "vendor": "node tools/vendor-skills.mjs && node tools/vendor-examples.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "license": "AGPL-3.0-only"
}
